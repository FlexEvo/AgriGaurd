void recordSoilData(Zone& zone){          //This function will record data from sensors.
    
    //This condition checks if the time difference between when it started and when it last recorded data is 30m
    if(millis() - timeCount >= soil_TimeStamp){     
      timeCount = millis();
       zone.soilPlaceHolder = analogRead(sensorOutPut);
      zone.timePlaceHolder = timeCount;   
    }  
}

void convertData(Zone& zone){          //This function converts raw data into percentages and stores them.
    float placeholder = 0;

    placeholder = (zone.dryCalibration - zone.soilPlaceHolder) / (zone.dryCalibration - zone.wetCalibration) * 100;      //Convert each data into a percentage

    if(placeholder < 0){
      placeholder = 0;
    }
    else if(placeholder > 100){
      placeholder = 100;
    }

  if(arrIndx < sampleSize){
    zone.soilMoistureData[arrIndx] = placeholder;
    zone.timeStampData[arrIndx] = zone.timePlaceHolder / 60000;       //Converts the millis time into minutes.
    arrIndx++;

  } else if(arrIndx >= sampleSize){
    arrIndx = 0;
  }

}

float getDryingRate(Zone& zone) {          //This function will determine the drying rates of the soil.

  float soil_dryRate = 0.0;

 //This ensure that it gets the rate after all 10 records have been read
  if(arrIndx == sampleSize-1){
    soil_dryRate = abs((zone.soilMoistureData[sampleSize-1] - zone.soilMoistureData[0]) / (zone.timeStampData[sampleSize-1] - zone.timeStampData[0]));  //abs() to ensure that we don't get a negative drying rate. 
  }
  else{
    Serial.println("Not all 10 readings have been made!");
  }

  return soil_dryRate;
}

double getThreshold(Zone& zone){
  
  double soilThreshold = 0;
  double loamyB1_thresholds = 37;
  double clayB1_thresholds = 47;
  double SandyB1_thresholds = 27;
  float dryRate = getDryingRate(zone);
  float tempPrec = weather[arrIndx].API_temp;
  float humidPerc = weather[arrIndx].API_humidity;

 //This determines the threshold for every hour
  if(arrIndx < DAILY_DATA){
    if(zone.soilTyp == CLAY){
    soilThreshold = abs(clayB1_thresholds + tempPrec + dryRate - humidPerc);
  } 
  else if(zone.soilTyp == SANDY){
    soilThreshold = abs(SandyB1_thresholds + tempPrec + dryRate - humidPerc);
  }
  else if(zone.soilTyp == LOAMY){
    soilThreshold = abs(loamyB1_thresholds + tempPrec + dryRate - humidPerc);
    }
  } 

  return soilThreshold;
}

//Create a condition that will first check if the number of elements is 10, then get the average of those elements and use it as your benchmark.
bool detIrrigation(Zone& zone){

  double threshold = getThreshold(zone);            //  This call the calculated threshold.
  double rain = weather[arrIndx].rain_prob;       
  float waterLvl = tank[arrIndx].waterPercentage;
  float soilMoisture = 0;   //!COME BACK TO THIS
  double counter = 0;       //Inrements soil_moisture data
  bool weatherAvail = false;
  
  if(arrIndx < sampleSize){
    return false;         //Safegaurd to make sure we have 10 records
  }

  //This gets the average of soil moisture readings
 for(int a = 0; a < sampleSize; a++){
      counter += zone.soilMoistureData[a];
    }

    soilMoisture = counter/sampleSize;
    //Send and store the reading to memory.
    //Reset the reading after storing them.
    //Reset the arrIndx.

    //Checks if it has values 
   if(rain > 0){
    weatherAvail = true;
   }


  //Primary condition checking if soil and water_levl are true
  if(waterLvl > waterLvl_limit && soilMoisture < threshold){
  zone.valveStatus = true;

 //This will put irrigation on hold ir rain is expected
  if(weatherAvail && rain > rain_threshold){
    zone.valveStatus = false;
    }
  }
 else{
  zone.valveStatus = false;
 }

  return zone.valveStatus;

}


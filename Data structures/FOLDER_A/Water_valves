float getStopDryingRate(){

  float dryRate = 0;
  float moistureChange = zone1.soilMoistureData[sampleSize - 1]- zone1.soilMoistureData[0];


  float timeChange = zone1.timeStampData[sampleSize - 1] - zone1.timeStampData[0];

  // Prevent division by zero
  if (timeChange <= 0)
    return 0;

  dryRate = abs(moistureChange / timeChange);
  return dryRate;
}

float getStopThreshold(){

  float dryRate = getStopDryingRate();
  double soilStopThreshold = 0;
  double loamyS1_threshold = 56;
  double clayS1_threshold = 70;
  double SandyS1_threshold = 48;
  //double weatherData = data.rain_prob;          //  This will call calculated rain prob.
  float tempPrec = data.API_temp;              //Gets temperature
  float humidPerc = data.API_humidity;              //Gets temperature

  if(zone1.soilTyp == CLAY){
  soilStopThreshold = clayS1_threshold + tempPrec + dryRate - humidPerc;
    }
  else if(zone1.soilTyp == SANDY){
    soilStopThreshold = SandyS1_threshold + tempPrec + dryRate - humidPerc;
  }
  else if(zone1.soilTyp == LOAMY){
    soilStopThreshold = loamyS1_threshold + tempPrec + dryRate - humidPerc;
  }

  if (soilStopThreshold > 100)
    soilStopThreshold = 100;

  else if (soilStopThreshold < 0)
    soilStopThreshold = 0;

  return soilStopThreshold;
}

bool stopIrrigation(){

  float stopThreshold = getStopThreshold();
  float waterLvl = waterZn.waterPercentage;
  float soilMoisture = zone1.newSoilReading;

  if(soilMoisture >= stopThreshold || waterLvl < 30){
  zone1.valveStatus = false;            //Turns off watering valves
  }

  return zone1.valveStatus;
}


//Come back to find better approach for duration
float irrigationDuration(){

  float moistureDeficit = 0;
  float stopThreshold = getStopThreshold();
  float currentMoisture = zone1.newSoilReading;
  float dryRate = getStopDryingRate();

  moistureDeficit = (stopThreshold - currentMoisture) * dryRate;

  return moistureDeficit;
}


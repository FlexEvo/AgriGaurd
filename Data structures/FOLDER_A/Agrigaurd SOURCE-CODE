// 12. IRRIGATION CONTROL FUNCTIONS
// ============================================================

void startIrrigation(Zone &zone) {
    if (systemState.emergencyActive) {
        Serial.println("Cannot irrigate - emergency active!");
        return;
    }
    
    if (waterTank.waterPercentage <= WATER_LEVEL_LIMIT) {
        Serial.println("Cannot irrigate - tank too low!");
        return;
    }
    
    resetFlowMeasurement();
    requiredWater = getRequiredWater(zone);
    
    if (requiredWater <= 0 || !enoughWater(requiredWater)) {
        Serial.println("Insufficient water available.");
        return;
    }
    
    irrigationProfile.preWateringMoisture = zone.currentSoilMoisture;
    irrigationStartTime = millis();
    valveON(zone);
    systemState.irrigationState = WATERING;
    activeZoneIndex = zone.zoneID - 1;
    
    Serial.print("Irrigation started on Zone ");
    Serial.print(zone.zoneID);
    Serial.print(" - Required: ");
    Serial.print(requiredWater);
    Serial.println("L");
}

void stopIrrigation(Zone &zone) {
    valveOFF(zone);
    irrigationProfile.waterSpent = getWaterVolume();
    unsigned long duration = millis() - irrigationStartTime;
    
    Serial.print("Irrigation stopped on Zone ");
    Serial.print(zone.zoneID);
    Serial.print(" - Used: ");
    Serial.print(irrigationProfile.waterSpent);
    Serial.print("L in ");
    Serial.print(duration / 60000.0);
    Serial.println(" minutes");
    
    settlingStartTime = millis();
    systemState.irrigationState = SETTLING;
}

void updateWatering(Zone &zone) {
    if (systemState.emergencyActive) return;
    
    getFlowRate();
    float waterDelivered = getWaterVolume();
    
    if (waterTank.waterPercentage <= WATER_LEVEL_LIMIT) {
        Serial.println("Tank too low - stopping irrigation!");
        stopIrrigation(zone);
        return;
    }
    
    if (waterDelivered >= requiredWater) {
        stopIrrigation(zone);
        return;
    }
    
    if (millis() - irrigationStartTime > SAFETY_TIMEOUT) {
        Serial.println("Safety timeout - stopping irrigation!");
        stopIrrigation(zone);
        return;
    }
}

void updateSettling(Zone &zone) {
    if (millis() - settlingStartTime < SETTLING_TIME) return;
    
    Serial.println("Settling period complete.");
    
    // Take post-watering reading
    float rawValue = analogRead(zone.sensorPin);
    float newMoisture = convertRawSoilToPercentage(zone, rawValue);
    zone.currentSoilMoisture = newMoisture;
    irrigationProfile.postWateringMoisture = newMoisture;
    
    irrigationProfile.irrigationCycles++;
    if (irrigationProfile.irrigationCycles > IRRIGATION_HISTORY_SIZE) {
        irrigationProfile.irrigationCycles = IRRIGATION_HISTORY_SIZE;
    }
    
    if (irrigationProfile.irrigationCycles > 1) {
        irrigationProfile.nextMoisture = newMoisture;
        calculatePreviousCycle();
    }
    
    systemState.irrigationState = IDLE;
    activeZoneIndex = -1;
    
    Serial.print("Post-irrigation moisture: ");
    Serial.print(newMoisture);
    Serial.println("%");
}

// ============================================================
// 13. LCD DISPLAY SYSTEM
// ============================================================

void initLCD() {
    lcd.init();
    lcd.backlight();
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("AGRIGUARD");
    lcd.setCursor(0, 1);
    lcd.print("Initializing...");
    delay(2000);
    lcd.clear();
}

void showLCDMessage(String message, unsigned long duration) {
    lcdMessage = message;
    lcdMessageStartTime = millis();
    lcdMessageTimer = duration;
    lcd.clear();
    
    if (message.length() <= LCD_COLUMNS) {
        lcd.setCursor(0, 0);
        lcd.print(message);
    } else {
        lcd.setCursor(0, 0);
        for (int i = 0; i < 16 && i < message.length(); i++) {
            lcd.print(message[i]);
        }
        lcd.setCursor(0, 1);
        for (int i = 16; i < 32 && i < message.length(); i++) {
            lcd.print(message[i]);
        }
    }
}

String getStateString(IrrigationState state) {
    switch(state) {
        case IDLE: return "IDLE";
        case WATERING: return "WATERING";
        case SETTLING: return "SETTLING";
        case CHECKING: return "CHECKING";
        case MAX_CYCLES_REACHED: return "MAX CYCLES";
        case EMERGENCY_STOP: return "EMERGENCY";
        default: return "UNKNOWN";
    }
}

String getSoilTypeString(SoilType type) {
    switch(type) {
        case CLAY: return "CLAY";
        case SANDY: return "SANDY";
        case LOAMY: return "LOAMY";
        default: return "UNKNOWN";
    }
}

void updateLCD() {
    // Show message if active
    if (millis() - lcdMessageStartTime < lcdMessageTimer) return;
    
    if (systemState.emergencyActive) {
        lcd.clear();
        lcd.setCursor(0, 0);
        lcd.print("!EMERGENCY STOP!");
        lcd.setCursor(0, 1);
        lcd.print("Press Reset");
        return;
    }
    
    if (millis() - lcdTimer < LCD_UPDATE_INTERVAL) return;
    lcdTimer = millis();
    
    lcd.clear();
    
    // Line 1: Zones 1 & 2
    lcd.setCursor(0, 0);
    lcd.print("Z1:");
    lcd.print(zones[0].currentSoilMoisture, 1);
    lcd.print("%");
    if (zones[0].isIrrigating) lcd.print("*");
    
    lcd.print(" Z2:");
    lcd.print(zones[1].currentSoilMoisture, 1);
    lcd.print("%");
    if (zones[1].isIrrigating) lcd.print("*");
    
    // Line 2: Zone 3 & System State
    lcd.setCursor(0, 1);
    lcd.print("Z3:");
    lcd.print(zones[2].currentSoilMoisture, 1);
    lcd.print("%");
    if (zones[2].isIrrigating) lcd.print("*");
    
    lcd.print(" ");
    lcd.print(getStateString(systemState.irrigationState));
    
    if (systemState.irrigationState == IDLE) {
        lcd.print(" ");
        lcd.print(zones[0].sampleCount);
        lcd.print("/");
        lcd.print(SAMPLE_SIZE);
    }
}

// ============================================================
// 14. SYSTEM SETUP
// ============================================================

void setup() {
    Serial.begin(115200);
    Serial.println("AGRIGUARD System Initializing...");
    
    // --------------------------------------------------------
    // SYSTEM STATE INITIALIZATION
    // --------------------------------------------------------
    
    systemState.powerState = POWER_OFF;
    systemState.irrigationState = IDLE;
    systemState.emergencyActive = false;
    systemState.weatherAvailable = false;
    systemState.wifiConnected = false;
    systemState.uptime = 0;
    
    // --------------------------------------------------------
    // PIN MODES
    // --------------------------------------------------------
    
    pinMode(SOIL_SENSOR_1, INPUT);
    pinMode(SOIL_SENSOR_2, INPUT);
    pinMode(SOIL_SENSOR_3, INPUT);
    pinMode(TANK_TRIGGER_PIN, OUTPUT);
    pinMode(TANK_ECHO_PIN, INPUT);
    pinMode(ZONE1_VALVE_PIN, OUTPUT);
    pinMode(ZONE2_VALVE_PIN, OUTPUT);
    pinMode(ZONE3_VALVE_PIN, OUTPUT);
    pinMode(FLOW_SENSOR_PIN, INPUT_PULLUP);
    pinMode(E_STOP_PIN, INPUT_PULLUP);
    pinMode(RESET_BUTTON_PIN, INPUT_PULLUP);
    
    // --------------------------------------------------------
    // SAFETY - Ensure all valves start OFF
    // --------------------------------------------------------
    
    digitalWrite(ZONE1_VALVE_PIN, LOW);
    digitalWrite(ZONE2_VALVE_PIN, LOW);
    digitalWrite(ZONE3_VALVE_PIN, LOW);
    
    // --------------------------------------------------------
    // FLOW SENSOR INTERRUPT
    // --------------------------------------------------------
    
    attachInterrupt(digitalPinToInterrupt(FLOW_SENSOR_PIN), countFlowPulse, RISING);
    
    // --------------------------------------------------------
    // LCD INITIALIZATION
    // --------------------------------------------------------
    
    initLCD();
    showLCDMessage("System Starting...", 2000);
    
    // --------------------------------------------------------
    // POWER SWITCH
    // --------------------------------------------------------
    
    initializePowerSwitch();
    
    // --------------------------------------------------------
    // ZONE CONFIGURATION
    // --------------------------------------------------------
    
    zones[0].zoneID = 1;
    zones[0].soilType = CLAY;
    zones[0].dryCalibration = 3000;
    zones[0].wetCalibration = 1200;
    zones[0].sampleCount = 0;
    zones[0].currentSoilMoisture = 0;
    zones[0].avgSoilMoisture = 0;
    zones[0].valveStatus = false;
    zones[0].isIrrigating = false;
    zones[0].sensorPin = SOIL_SENSOR_1;
    zones[0].valvePin = ZONE1_VALVE_PIN;
    zones[0].lastRecordTime = millis() - SOIL_RECORD_INTERVAL;
    
    zones[1].zoneID = 2;
    zones[1].soilType = SANDY;
    zones[1].dryCalibration = 2800;
    zones[1].wetCalibration = 1000;
    zones[1].sampleCount = 0;
    zones[1].currentSoilMoisture = 0;
    zones[1].avgSoilMoisture = 0;
    zones[1].valveStatus = false;
    zones[1].isIrrigating = false;
    zones[1].sensorPin = SOIL_SENSOR_2;
    zones[1].valvePin = ZONE2_VALVE_PIN;
    zones[1].lastRecordTime = millis() - SOIL_RECORD_INTERVAL;
    
    zones[2].zoneID = 3;
    zones[2].soilType = LOAMY;
    zones[2].dryCalibration = 2900;
    zones[2].wetCalibration = 1100;
    zones[2].sampleCount = 0;
    zones[2].currentSoilMoisture = 0;
    zones[2].avgSoilMoisture = 0;
    zones[2].valveStatus = false;
    zones[2].isIrrigating = false;
    zones[2].sensorPin = SOIL_SENSOR_3;
    zones[2].valvePin = ZONE3_VALVE_PIN;
    zones[2].lastRecordTime = millis() - SOIL_RECORD_INTERVAL;
    
    // --------------------------------------------------------
    // TANK CONFIGURATION
    // --------------------------------------------------------
    
    waterTank.model = JJ2;
    
    // --------------------------------------------------------
    // IRRIGATION PROFILE
    // --------------------------------------------------------
    
    irrigationProfile.zoneID = 1;
    irrigationProfile.irrigationCycles = 0;
    irrigationProfile.averageLitresPerPercentage = 0;
    irrigationProfile.averageDryingRate = 0;
    irrigationProfile.averageWaterPerCycle = 0;
    irrigationProfile.averageCycleDuration = 0;
    
    // --------------------------------------------------------
    // TIMER INITIALIZATION
    // --------------------------------------------------------
    
    tankTimer = millis() - TANK_RECORD_INTERVAL;
    weatherTimer = millis() - WEATHER_INTERVAL;
    lcdTimer = millis() - LCD_UPDATE_INTERVAL;
    lcdMessageStartTime = 0;
    lcdMessageTimer = 0;
    
    // --------------------------------------------------------
    // WIFI & WEATHER
    // --------------------------------------------------------
    
    connectWiFi();
    if (systemState.wifiConnected) {
        showLCDMessage("WiFi Connected", 2000);
        fetchWeatherData();
    } else {
        showLCDMessage("No WiFi - Using defaults", 2000);
    }
    
    // --------------------------------------------------------
    // SYSTEM READY
    // --------------------------------------------------------
    
    systemState.powerState = POWER_ON;
    showLCDMessage("AGRIGUARD READY", 2000);
    
    Serial.println("==========================================");
    Serial.println("       AGRIGUARD ONLINE");
    Serial.println("       System Ready");
    Serial.println("==========================================");
}

// ============================================================
// 15. MAIN LOOP
// ============================================================

void loop() {
    // ========================================================
    // SYSTEM POWER MANAGEMENT
    // ========================================================
    
    if (!isSystemPoweredOn()) {
        delay(100);
        return;
    }
    
    // ========================================================
    // EMERGENCY STOP MONITORING
    // ========================================================
    
    checkEmergencyStop();
    if (systemState.emergencyActive) {
        handleEmergencyState();
        updateLCD();
        delay(50);
        yield();
        return;
    }
    
    // ========================================================
    // SOIL MOISTURE MONITORING
    // ========================================================
    
    static int currentZoneIndex = 0;
    recordSoilData(zones[currentZoneIndex]);
    currentZoneIndex = (currentZoneIndex + 1) % 3;
    
    // Update averages
    for (int i = 0; i < 3; i++) {
        if (zones[i].sampleCount > 0) {
            zones[i].avgSoilMoisture = getAverageSoilMoisture(zones[i]);
        }
    }
    
    // ========================================================
    // TANK MONITORING
    // ========================================================
    
    updateTank();
    updateWaterBudget();
    
    // ========================================================
    // WEATHER UPDATES (Hourly)
    // ========================================================
    
    if (millis() - weatherTimer >= WEATHER_INTERVAL) {
        weatherTimer = millis();
        connectWiFi();
        if (systemState.wifiConnected) {
            fetchWeatherData();
        }
    }
    
    // ========================================================
    // IRRIGATION DECISION ENGINE
    // ========================================================
    
    static int irrigationZoneIndex = 0;
    
    switch (systemState.irrigationState) {
        case IDLE:
            if (shouldStartIrrigation(zones[irrigationZoneIndex])) {
                startIrrigation(zones[irrigationZoneIndex]);
            }
            irrigationZoneIndex = (irrigationZoneIndex + 1) % 3;
            break;
            
        case WATERING:
            updateWatering(zones[irrigationZoneIndex]);
            break;
            
        case SETTLING:
            updateSettling(zones[irrigationZoneIndex]);
            break;
            
        case CHECKING:
            systemState.irrigationState = IDLE;
            activeZoneIndex = -1;
            break;
            
        case MAX_CYCLES_REACHED:
            for (int i = 0; i < 3; i++) {
                if (zones[i].valveStatus) valveOFF(zones[i]);
            }
            systemState.irrigationState = IDLE;
            activeZoneIndex = -1;
            break;
            
        case EMERGENCY_STOP:
            handleEmergencyState();
            break;
    }
    
    // ========================================================
    // WATER BUDGET PREDICTIONS
    // ========================================================
    
    if (systemState.irrigationState == IDLE) {
        waterBudget.predictedDemand = predictWaterDemand(zones[0]);
    }
    
    // ========================================================
    // LCD DISPLAY
    // ========================================================
    
    updateLCD();
    
    // ========================================================
    // SYSTEM STATUS LOGGING (Every 30 seconds)
    // ========================================================
    
    static unsigned long statusTimer = 0;
    if (millis() - statusTimer >= 30000UL) {
        statusTimer = millis();
        systemState.uptime += 30;
        
        Serial.println("========== STATUS ==========");
        Serial.print("Uptime: ");
        Serial.print(systemState.uptime);
        Serial.println(" seconds");
        Serial.print("State: ");
        Serial.println(getStateString(systemState.irrigationState));
        Serial.print("Tank: ");
        Serial.print(waterTank.waterPercentage);
        Serial.println("%");
        for (int i = 0; i < 3; i++) {
            Serial.print("Zone ");
            Serial.print(i + 1);
            Serial.print(": ");
            Serial.print(zones[i].currentSoilMoisture);
            Serial.print("%");
            if (zones[i].isIrrigating) Serial.print(" *");
            Serial.println();
        }
        Serial.println("============================");
    }
    
    // ========================================================
    // PREVENT WATCHDOG TIMER
    // ========================================================
    
    yield();
    delay(10);
}

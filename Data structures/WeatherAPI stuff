#include <WiFi.h>
#include <HTTPClient.h>
#include <ArduinoJson.h>

//Global variables
const char* ssid = "";       //Find better solution
const char* password = "";      //Find better solution

struct weather_API{

  String description;
  float API_temp;
  float API_humidity;
  float rain_prob;

};

String API_URL = "https://pro.openweathermap.org/data/2.5/forecast/hourly?";
String API_key = "3ca8b05fac70db4002e6b393c9dbb0eb";                  //Just an API placeholder and NOT for production 

float LAT = -29.35080374459709;
float LON = 27.601807742259524;
weather_API data;


void setup() {
  
  Serial.begin(115200);

  WiFi.begin(ssid, password);

  while(WiFi.status() != WL_CONNECTED){
    delay(500);
    Serial.println(".");
  }

  Serial.println("WiFi connected.");
  Serial.println("IP address: ");
  Serial.println(WiFi.localIP());

}

void getWeatherData(){

//This condition checks if the system has connected to the internet
 if(WiFi.status() == WL_CONNECTED){       
  
   HTTPClient httpObj;          //This object will enable the system to make HTTP requests

  String requestURL = API_URL + "lat=" + String(LAT, 6) + "&lon=" + String(LON, 6) + "&units=metric" + "&appid=" + API_key;

  httpObj.begin(requestURL);       //Sends an HTTP request with all data included e.g (LAT, LON, API_KEY).



   int httpCode = httpObj.GET();        //Creates a connection to send the HTTP request

    //Confrims if data was recieved
   if(httpCode > 0){
    String Json_Data = httpObj.getString();      //Read data 
    Serial.println(Json_Data);

    //Retrieves weather data as json
    DynamicJsonDocument doc(8192);            //Memory allocated to store Json data
    DeserializationError error = deserializeJson(doc, Json_Data);

    if(error){
    Serial.print("JSON error: ");
    Serial.println(error.c_str());
    return;
    }

    JsonObject jsonOb = doc.as<JsonObject>();

    //Display data
    data.description = jsonOb["list"][0]["weather"][0]["description"].as<String>();;
    data.API_temp = jsonOb["list"][0]["main"]["temp"].as<float>();
    data.API_humidity = jsonOb["list"][0]["main"]["humidity"].as<float>();
    data.rain_prob = jsonOb["list"][0]["pop"].as<float>() * 100.0;
    
   } else{
    Serial.println("Error: Cannot retrieve data!");
  }

   httpObj.end();
  }


}

void loop() {

getWeatherData();
delay(3600000);

}


void connectWiFi() {
    if (WiFi.status() == WL_CONNECTED) {
        systemState.wifiConnected = true;
        return;
    }
    
    Serial.println("Connecting to WiFi...");
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
    unsigned long startAttempt = millis();
    
    while (WiFi.status() != WL_CONNECTED && millis() - startAttempt < 15000) {
        delay(100);
        Serial.print(".");
        yield();
    }
    Serial.println();
    
    systemState.wifiConnected = (WiFi.status() == WL_CONNECTED);
    if (systemState.wifiConnected) {
        Serial.println("WiFi connected. IP: " + WiFi.localIP().toString());
    } else {
        Serial.println("WiFi connection failed.");
    }
}

String buildWeatherURL() {
    return "https://api.open-meteo.com/v1/forecast?latitude=" + String(LAT) + "&longitude=" + String(LON) 
           + "&hourly=temperature_2m,relative_humidity_2m,precipitation_probability,precipitation&forecast_days=2&timezone=auto";
}

void fetchWeatherData() {
    if (!systemState.wifiConnected || systemState.weatherAvailable)
     return;
    
    HTTPClient http;
    String url = buildWeatherURL();
    Serial.println("Fetching weather data...");
    
    http.setConnectTimeout(10000);
    http.setTimeout(15000);
    http.begin(url);
    int httpCode = http.GET();
    
    if (httpCode == HTTP_CODE_OK) {
        String jsonData = http.getString();
        weatherDoc.clear();
        DeserializationError error = deserializeJson(weatherDoc, jsonData);
        
        if (!error) {
            JsonObject jsonOb = weatherDoc.as<JsonObject>();
            for (int i = 0; i < DAILY_DATA; i++) {
                weather[i].temperature = jsonOb["hourly"]["temperature_2m"][i].as<float>();
                weather[i].humidity = jsonOb["hourly"]["relative_humidity_2m"][i].as<float>();
                weather[i].rainProbability = jsonOb["hourly"]["precipitation_probability"][i].as<float>();
            }
            systemState.weatherAvailable = true;
            Serial.println("Weather data updated.");
        }
        jsonData = String();
        weatherDoc.clear();
    } else {
        Serial.print("Weather HTTP error: ");
        Serial.println(httpCode);
    }
    http.end();
}

WeatherData getCurrentWeather() {
